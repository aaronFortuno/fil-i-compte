{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fil i compte · paquet d'exercicis estàtics",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "pack",
    "exercises"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language",
        "version",
        "authorship",
        "review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "ca"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "authorship": {
          "type": "string"
        },
        "review": {
          "type": "string"
        }
      }
    },
    "exercises": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/exercise"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "numericType": {
      "enum": [
        "naturals",
        "enters",
        "decimals",
        "fraccions"
      ]
    },
    "calculation": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "pow"
              ]
            },
            {
              "$ref": "#/$defs/calculation"
            },
            {
              "$ref": "#/$defs/calculation"
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "sqrt"
            },
            {
              "$ref": "#/$defs/calculation"
            }
          ],
          "minItems": 2,
          "maxItems": 2
        }
      ]
    },
    "visual": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "groups",
            "perGroup",
            "removed",
            "caption"
          ],
          "properties": {
            "type": {
              "const": "objects"
            },
            "groups": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "perGroup": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            },
            "removed": {
              "type": "integer",
              "minimum": 0
            },
            "caption": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "parts",
            "filled",
            "total",
            "caption"
          ],
          "properties": {
            "type": {
              "const": "fraction"
            },
            "parts": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12
            },
            "filled": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "caption": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "side",
            "removed",
            "caption"
          ],
          "properties": {
            "type": {
              "const": "grid"
            },
            "side": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "removed": {
              "type": "integer",
              "minimum": 0
            },
            "caption": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "widthLabel",
            "heightLabel",
            "caption"
          ],
          "properties": {
            "type": {
              "const": "rectangle"
            },
            "widthLabel": {
              "$ref": "#/$defs/text"
            },
            "heightLabel": {
              "$ref": "#/$defs/text"
            },
            "caption": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "sideLabel",
            "areaLabel",
            "gapLabel",
            "caption"
          ],
          "properties": {
            "type": {
              "const": "square"
            },
            "sideLabel": {
              "$ref": "#/$defs/text"
            },
            "areaLabel": {
              "$ref": "#/$defs/text"
            },
            "gapLabel": {
              "$ref": "#/$defs/text"
            },
            "caption": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "title",
        "context",
        "structure",
        "level",
        "difficulty",
        "status",
        "statement",
        "features",
        "numeric"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{4,}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "context": {
          "$ref": "#/$defs/text"
        },
        "structure": {
          "$ref": "#/$defs/text"
        },
        "level": {
          "enum": [
            "mitja",
            "superior",
            "eso"
          ]
        },
        "difficulty": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "status": {
          "enum": [
            "esborrany",
            "pendent-docent",
            "validat"
          ]
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "question": {
          "$ref": "#/$defs/text"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "suma-resta",
              "multiplicacio-divisio",
              "combinades",
              "parentesis",
              "fraccions",
              "percentatges",
              "decimals",
              "potencies",
              "arrels",
              "distractors"
            ]
          }
        },
        "numeric": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "data",
            "intermediate",
            "result"
          ],
          "properties": {
            "data": {
              "$ref": "#/$defs/numericType"
            },
            "intermediate": {
              "$ref": "#/$defs/numericType"
            },
            "result": {
              "$ref": "#/$defs/numericType"
            }
          }
        },
        "solution": {
          "$ref": "#/$defs/solution"
        },
        "parts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "solution"
            ],
            "properties": {
              "question": {
                "$ref": "#/$defs/text"
              },
              "solution": {
                "$ref": "#/$defs/solution"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "question",
            "solution"
          ],
          "properties": {
            "parts": false
          }
        },
        {
          "required": [
            "parts"
          ],
          "properties": {
            "question": false,
            "solution": false
          }
        }
      ]
    },
    "numericSolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expression",
        "calculation",
        "answer",
        "unit",
        "response",
        "steps",
        "note"
      ],
      "properties": {
        "expression": {
          "$ref": "#/$defs/text"
        },
        "calculation": {
          "$ref": "#/$defs/calculation"
        },
        "answer": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "response": {
          "$ref": "#/$defs/text"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "justification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "response",
        "steps",
        "note",
        "evidence"
      ],
      "properties": {
        "kind": {
          "const": "justification"
        },
        "response": {
          "$ref": "#/$defs/text"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "note": {
          "type": "string"
        },
        "visual": {
          "$ref": "#/$defs/visual"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "calculation",
              "answer"
            ],
            "properties": {
              "calculation": {
                "$ref": "#/$defs/calculation"
              },
              "answer": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "solution": {
      "oneOf": [
        {
          "$ref": "#/$defs/numericSolution"
        },
        {
          "$ref": "#/$defs/justification"
        }
      ]
    }
  }
}
